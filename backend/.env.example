# Variables de entorno del backend Synapse (copiar a .env y ajustar)
# Usadas en desarrollo local, Docker y CI/CD.

# Servidor
PORT=5000

# JWT
JWT_SECRET=cambiar-este-secreto-en-produccion
JWT_EXPIRES_IN=8h

# Base de datos MySQL
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASS=
DB_NAME=synapse
DB_NAME_TEST=synapse_test

# AWS (se inyectarán cuando se habilite la etapa de la nube)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=
S3_BUCKET_NAME=